[Unit]
Description=Omarchy fan curve daemon
Documentation=file:///usr/local/share/doc/omarchy-fans/README.md
After=systemd-modules-load.service
# arc-fan (standalone Arc fan daemon) writes the same GPU fan table.
Conflicts=arc-fan.service
# Ordering makes systemd stop arc-fan (whose ExecStopPost restores the stock
# curve) before starting us, not concurrently. One direction is enough.
After=arc-fan.service

[Service]
Type=simple
ExecStartPre=-/usr/bin/modprobe it87
ExecStart=/usr/local/bin/omarchy-fand run
# However the daemon exits (even SIGKILL), hand the fans back to the BIOS.
ExecStopPost=/usr/local/bin/omarchy-fand restore
Restart=on-failure
RestartSec=3
RuntimeDirectory=omarchy-fans
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
StateDirectory=omarchy-fans

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
MemoryDenyWriteExecute=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
